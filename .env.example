# Copy to .env.local (never committed). Values are inlined into the browser bundle.
# Local development: `npx supabase status` prints both values.

NEXT_PUBLIC_SUPABASE_URL=
# Publishable key only (sb_publishable_…). Never a secret (sb_secret_…) or
# service_role key: those bypass RLS. The build refuses to run with one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
