/**
 * Post-build step (`npm run build`): writes out/sw.js from features/offline/sw.ts with the list
 * of files this build exported, read from out/ itself, so no hashed file name is ever maintained
 * by hand. Runs on Node's built-in TypeScript support; compiles the worker with the project's
 * TypeScript (no extra dependency).
 */
import { readdir, readFile, writeFile } from 'node:fs/promises';
import path from 'node:path';
import ts from 'typescript';
import { cacheName, precacheUrl, selectPrecacheFiles } from './precache.mts';

const root = path.resolve(import.meta.dirname, '..');
const outDir = path.join(root, 'out');
const workerSourcePath = path.join(root, 'features', 'offline', 'sw.ts');

async function listFiles(dir: string, prefix = ''): Promise<string[]> {
  const entries = await readdir(dir, { withFileTypes: true });
  const nested = await Promise.all(
    entries.map((entry) => {
      const relative = prefix ? `${prefix}/${entry.name}` : entry.name;
      return entry.isDirectory() ? listFiles(path.join(dir, entry.name), relative) : Promise.resolve([relative]);
    }),
  );
  return nested.flat();
}

/** TypeScript → classic script: types erased, `export` dropped (a service worker script has no module scope here). */
function compileWorker(source: string): string {
  if (/^\s*import\s/m.test(source)) throw new Error('features/offline/sw.ts must not import anything.');
  const { outputText } = ts.transpileModule(source, {
    compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext, removeComments: false },
  });
  const script = outputText.replace(/^export \{\};?\s*$/gm, '').replace(/^export (?=(async )?function |const |let |class )/gm, '');
  if (/^\s*export\s/m.test(script)) throw new Error('Unexpected export left in the compiled service worker.');
  return script;
}

async function main() {
  const files = selectPrecacheFiles(await listFiles(outDir));
  if (!files.includes('index.html') || !files.some((file) => file.startsWith('_next/static/'))) {
    throw new Error('out/ does not look like a Next.js static export. Run `next build` first.');
  }
  const contents = await Promise.all(files.map(async (file) => ({ file, content: await readFile(path.join(outDir, file)) })));
  const workerSource = await readFile(workerSourcePath, 'utf8');
  const name = cacheName(contents, workerSource);
  const urls = files.map(precacheUrl);

  const output =
    `// Generated by scripts/build-sw.mts from features/offline/sw.ts. Do not edit.\n` +
    `'use strict';\n` +
    `const __WK_CACHE_NAME__ = ${JSON.stringify(name)};\n` +
    `const __WK_PRECACHE__ = ${JSON.stringify(urls, null, 0)};\n` +
    compileWorker(workerSource);

  await writeFile(path.join(outDir, 'sw.js'), output);
  const bytes = contents.reduce((sum, { content }) => sum + content.byteLength, 0);
  console.log(`sw.js: ${urls.length} files precached (${(bytes / 1024).toFixed(0)} KiB), cache ${name}`);
}

await main();
